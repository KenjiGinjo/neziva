meta {
  name: 获取工作流列表
  type: http
  seq: 1
}

get {
  url: {{API_URL}}/workflows?page=1&pageSize=20&status=active&search=test
  body: none
  auth: bearer
}

auth:bearer {
  token: {{USER_TOKEN}}
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response contains items and total", function() {
    expect(res.body.data).to.have.property('items');
    expect(res.body.data).to.have.property('total');
  });
}
