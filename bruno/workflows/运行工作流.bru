meta {
  name: 运行工作流
  type: http
  seq: 6
}

post {
  url: {{API_URL}}/workflows/{{WORKFLOW_ID}}/run
  body: json
  auth: bearer
}

auth:bearer {
  token: {{USER_TOKEN}}
}

body:json {
  {
    "inputData": {}
  }
}

script:post-response {
  const data = res.getBody();
  if (data.data && data.data.executionId) {
    bru.setEnvVar("EXECUTION_ID", data.data.executionId);
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
}
