meta {
  name: 获取博客文章列表-分页测试
  type: http
  seq: 10
}

get {
  url: {{ADMIN_URL}}/admin/blog/posts
  body: none
  auth: bearer
}

params:query {
  page: 2
  pageSize: 5
  status:
  category:
  tag:
  search:
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Pagination info is correct", function() {
    expect(res.body.pagi).to.have.property('limit', 5);
    expect(res.body.pagi).to.have.property('offset');
    expect(res.body.pagi).to.have.property('total');
  });
  
  test("Data length matches limit", function() {
    expect(res.body.data.length).to.be.at.most(5);
  });
}
