meta {
  name: 发布博客文章
  type: http
  seq: 5
}

put {
  url: {{ADMIN_URL}}/api/admin/blog/posts/:id/publish
  body: json
  auth: bearer
}

params:path {
  id: clx1234567890
}

body:json {
  {
    "status": 1
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Post status is updated", function() {
    expect(res.body.data).to.have.property('status');
    expect(res.body.data.status).to.equal(1);
  });
}
