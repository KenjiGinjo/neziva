meta {
  name: 获取博客文章列表-筛选已发布
  type: http
  seq: 5
}

get {
  url: {{ADMIN_URL}}/admin/blog/posts
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 20
  status: 1
  category:
  tag:
  search:
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response contains posts array", function() {
    expect(res.body).to.have.property('data');
    expect(res.body.data).to.be.an('array');
  });
  
  test("All posts are published", function() {
    if (res.body.data && res.body.data.length > 0) {
      res.body.data.forEach(post => {
        expect(post.status).to.equal(1);
      });
    }
  });
}
