meta {
  name: 获取博客文章列表-筛选草稿
  type: http
  seq: 6
}

get {
  url: {{ADMIN_URL}}/admin/blog/posts
  body: none
  auth: bearer
}

params:query {
  page: 1
  pageSize: 20
  status: 0
  category:
  tag:
  search:
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("All posts are drafts", function() {
    if (res.body.data && res.body.data.length > 0) {
      res.body.data.forEach(post => {
        expect(post.status).to.equal(0);
      });
    }
  });
}
