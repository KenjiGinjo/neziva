meta {
  name: 获取联系表单列表-筛选已回复
  type: http
  seq: 5
}

get {
  url: {{ADMIN_URL}}/api/admin/contact/forms
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 20
  status: 2
  projectType:
  search:
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("All forms are replied", function() {
    if (res.body.data && res.body.data.length > 0) {
      res.body.data.forEach(form => {
        expect(form.status).to.equal(2);
      });
    }
  });
}
