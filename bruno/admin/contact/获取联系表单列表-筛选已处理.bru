meta {
  name: 获取联系表单列表-筛选已处理
  type: http
  seq: 4
}

get {
  url: {{ADMIN_URL}}/admin/contact/forms
  body: none
  auth: bearer
}

params:query {
  page: 1
  pageSize: 20
  status: 1
  projectType:
  search:
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("All forms are processed", function() {
    if (res.body.data && res.body.data.length > 0) {
      res.body.data.forEach(form => {
        expect(form.status).to.equal(1);
      });
    }
  });
}
