meta {
  name: 获取联系表单列表
  type: http
  seq: 1
}

get {
  url: {{ADMIN_URL}}/api/admin/contact/forms
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 20
  status:
  projectType:
  search:
  startDate:
  endDate:
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response contains forms array", function() {
    expect(res.body).to.have.property('data');
    expect(res.body.data).to.be.an('array');
  });
}
