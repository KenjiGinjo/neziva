meta {
  name: 获取订阅者列表-筛选已订阅
  type: http
  seq: 4
}

get {
  url: {{ADMIN_URL}}/admin/newsletter/subscribers
  body: none
  auth: bearer
}

params:query {
  page: 1
  pageSize: 20
  status: 1
  source:
  search:
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("All subscribers are subscribed", function() {
    if (res.body.data && res.body.data.length > 0) {
      res.body.data.forEach(subscriber => {
        expect(subscriber.status).to.equal(1);
      });
    }
  });
}
