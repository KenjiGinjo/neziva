}

get {
  url: {{ADMIN_URL}}/admin/newsletter/subscribers
  body: none
  auth: bearer
}

params:query {
  page: 1
  pageSize: 20
  status:
  source:
  search:
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response contains subscribers array", function() {
    expect(res.body).to.have.property('data');
    expect(res.body.data).to.be.an('array');
  });
}
