meta {
  name: 获取订阅者列表-筛选已退订
  type: http
  seq: 5
}

get {
  url: {{ADMIN_URL}}/api/admin/newsletter/subscribers
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 20
  status: 2
  source:
  search:
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("All subscribers are unsubscribed", function() {
    if (res.body.data && res.body.data.length > 0) {
      res.body.data.forEach(subscriber => {
        expect(subscriber.status).to.equal(2);
      });
    }
  });
}
