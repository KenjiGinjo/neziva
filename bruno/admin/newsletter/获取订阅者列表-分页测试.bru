meta {
  name: 获取订阅者列表-分页测试
  type: http
  seq: 8
}

get {
  url: {{ADMIN_URL}}/admin/newsletter/subscribers
  body: none
  auth: bearer
}

params:query {
  page: 2
  pageSize: 10
  status:
  source:
  search:
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Pagination info is correct", function() {
    expect(res.body.pagi).to.have.property('limit', 10);
    expect(res.body.pagi).to.have.property('offset');
    expect(res.body.pagi).to.have.property('total');
  });
}
