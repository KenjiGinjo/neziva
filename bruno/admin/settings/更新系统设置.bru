meta {
  name: 更新系统设置
  type: http
  seq: 2
}

put {
  url: {{ADMIN_URL}}/settings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ADMIN_TOKEN}}
}

body:json {
  {
    "maintenanceMode": false,
    "maxApiCallsPerUser": 1000,
    "maxWorkflowsPerUser": 50,
    "features": {},
    "emailService": {
      "provider": "smtp"
    },
    "payment": {}
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
}
