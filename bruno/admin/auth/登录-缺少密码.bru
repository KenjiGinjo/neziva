meta {
  name: 登录-缺少密码
  type: http
  seq: 5
}

post {
  url: {{ADMIN_URL}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "admin"
  }
}

tests {
  test("Status code is 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Response contains validation error", function() {
    expect(res.body).to.have.property('message');
  });
}
