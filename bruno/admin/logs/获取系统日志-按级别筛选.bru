meta {
  name: 获取系统日志-按级别筛选
  type: http
  seq: 4
}

get {
  url: {{ADMIN_URL}}/logs
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 20
  level: 1
  startDate:
  endDate:
  search:
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("All logs match level", function() {
    if (res.body.data.items && res.body.data.items.length > 0) {
      res.body.data.items.forEach(log => {
        expect(log.type).to.equal(1);
      });
    }
  });
}
