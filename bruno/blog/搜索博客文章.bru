meta {
  name: 搜索博客文章
  type: http
  seq: 3
}

get {
  url: {{API_URL}}/blog/search
  body: none
  auth: none
}

params:query {
  keyword: sldklksdj
  page: 1
  pageSize: 10
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response contains search results", function() {
    expect(res.body).to.have.property('data');
    expect(res.body.data).to.be.an('array');
  });

  test("Response contains query info", function() {
    expect(res.body).to.have.property('query');
    expect(res.body.query).to.equal('sldklksdj');
  });

  test("Response contains pagination info", function() {
    expect(res.body).to.have.property('pagination');
    expect(res.body.pagination).to.have.property('limit');
    expect(res.body.pagination).to.have.property('offset');
    expect(res.body.pagination).to.have.property('total');
  });
}
