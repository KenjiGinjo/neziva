meta {
  name: 获取博客文章列表-边界值测试
  type: http
  seq: 6
}

get {
  url: {{API_URL}}/blog/posts
  body: none
  auth: none
}

params:query {
  page: 1
  pageSize: 1
  category:
  tag:
  featured:
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Returns at most 1 post", function() {
    expect(res.body.data.length).to.be.at.most(1);
  });
}
