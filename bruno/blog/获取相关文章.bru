meta {
  name: 获取相关文章
  type: http
  seq: 4
}

get {
  url: {{API_URL}}/blog/related/:id
  body: none
  auth: none
}

params:path {
  id: clx1234567890
}

params:query {
  limit: 5
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response contains related posts array", function() {
    expect(res.body).to.have.property('data');
    expect(res.body.data).to.be.an('array');
  });

  test("Related posts count is within limit", function() {
    expect(res.body.data.length).to.be.at.most(5);
  });
}
