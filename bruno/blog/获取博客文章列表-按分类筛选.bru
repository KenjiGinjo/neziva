meta {
  name: 获取博客文章列表-按分类筛选
  type: http
  seq: 2
}

get {
  url: {{API_URL}}/blog/posts
  body: none
  auth: none
}

params:query {
  page: 1
  pageSize: 10
  category: Technical Insights
  tag:
  featured:
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("All posts match category", function() {
    if (res.body.data && res.body.data.length > 0) {
      res.body.data.forEach(post => {
        expect(post.category).to.equal("Technical Insights");
      });
    }
  });
}
