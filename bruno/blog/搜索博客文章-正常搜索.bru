meta {
  name: 搜索博客文章-正常搜索
  type: http
  seq: 3
}

get {
  url: {{API_URL}}/blog/search
  body: none
  auth: none
}

params:query {
  page: 1
  pageSize: 10
  keyword: AI
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response contains query", function() {
    expect(res.body).to.have.property('query', 'AI');
  });
  
  test("Response contains posts array", function() {
    expect(res.body).to.have.property('data');
    expect(res.body.data).to.be.an('array');
  });
}
