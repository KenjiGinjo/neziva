meta {
  name: 获取博客文章列表
  type: http
  seq: 1
}

get {
  url: {{API_URL}}/blog/posts
  body: none
  auth: none
}

params:query {
  page: 1
  pageSize: 10
  category:
  tag:
  featured:
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response contains posts array", function() {
    expect(res.body).to.have.property('data');
    expect(res.body.data).to.be.an('array');
  });

  test("Response contains pagination info", function() {
    expect(res.body).to.have.property('pagination');
    expect(res.body.pagination).to.have.property('limit');
    expect(res.body.pagination).to.have.property('offset');
    expect(res.body.pagination).to.have.property('total');
  });
}
