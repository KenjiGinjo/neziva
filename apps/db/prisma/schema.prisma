generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cache {
  key       String    @id @db.VarChar
  value     String    @db.Text
  expiresAt DateTime? @map("expires_at") @db.Timestamp

  @@map("__cache")
}

model Admin {
  id        String   @id @default(cuid()) @db.VarChar
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  username String  @unique @db.VarChar
  password String  @db.VarChar
  nickname String? @db.VarChar
  avatar   String? @db.VarChar
  phone    String? @db.VarChar
  email    String? @db.VarChar
  status   Int     @default(0) @db.SmallInt

  role Json @default("[]") @db.Json

  @@map("admin")
}


model ErrorLog {
  id        String   @id @default(cuid()) @db.VarChar
  createdAt DateTime @default(now()) @map("created_at")
  type      Int      @db.SmallInt
  code      String   @db.Text
  detail    String   @db.Text
  path      String?  @db.Text
  method    String?  @db.Text
  query     Json?    @db.Json
  body      Json?    @db.Json
  headers   Json?    @db.Json
  stack     String?  @db.Text

  @@map("error_log")
}

// 联系表单提交记录
model ContactForm {
  id          String    @id @default(cuid()) @db.VarChar
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  name        String    @db.VarChar(255)
  company     String?   @db.VarChar(255)
  email       String    @db.VarChar(255)
  phone       String?   @db.VarChar(50)
  projectType String    @map("project_type") @db.VarChar(50)
  description String    @db.Text
  budget      String?   @db.VarChar(50)
  status      Int       @default(0) @db.SmallInt // 0: 未处理, 1: 已处理, 2: 已回复
  notes       String?   @db.Text // 管理员备注

  @@index([email])
  @@index([createdAt])
  @@index([status])
  @@map("contact_form")
}

// 博客文章
model BlogPost {
  id          String    @id @default(cuid()) @db.VarChar
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  publishedAt DateTime? @map("published_at") @db.Timestamp

  title       String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(255)
  content     String    @db.Text
  excerpt     String?   @db.Text // 摘要
  category    String    @db.VarChar(100)
  tags        String[]  @default([]) // 标签数组
  author      String    @db.VarChar(100)
  readTime    Int       @default(0) @map("read_time") @db.SmallInt // 阅读时长（分钟）
  views       Int       @default(0) @db.Integer // 浏览次数
  featured    Boolean   @default(false) // 是否精选
  status      Int       @default(0) @db.SmallInt // 0: 草稿, 1: 已发布, 2: 已归档
  coverImage  String?   @map("cover_image") @db.VarChar(500) // 封面图片URL
  seoTitle    String?   @map("seo_title") @db.VarChar(255) // SEO标题
  seoDesc     String?   @map("seo_desc") @db.Text // SEO描述

  @@index([category])
  @@index([status])
  @@index([publishedAt])
  @@index([featured])
  @@map("blog_post")
}

// Newsletter 订阅
model Newsletter {
  id          String    @id @default(cuid()) @db.VarChar
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  email       String    @unique @db.VarChar(255)
  status      Int       @default(0) @db.SmallInt // 0: 待验证, 1: 已订阅, 2: 已退订
  verifiedAt  DateTime? @map("verified_at") @db.Timestamp // 验证时间
  unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamp // 退订时间
  source      String?   @db.VarChar(100) // 订阅来源（如：homepage, blog, etc.）

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("newsletter")
}
