{
  "name": "db",
  "version": "0.0.1",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit",
    "db:client": "prisma studio",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:format-fix": "prisma-case-format --file prisma/schema.prisma --table-case=pascal --field-case=camel --map-table-case=snake,singular --map-field-case=snake",
    "db:rebuild": "rm -rf prisma/migrations && prisma db push --force-reset --accept-data-loss && prisma db seed",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "db:test": "bun test --env-file=.env.db.test --preload ./test/_setup.ts",
    "db:test-rebuild": "dotenvx run -f .env.db.test -- prisma db push --skip-generate --force-reset --accept-data-loss",
    "db:backup": "bun scripts/backup.ts",
    "db:restore": "bun scripts/restore.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^9.3.0",
    "@neziva/constants": "workspace:*",
    "@neziva/enums": "workspace:*",
    "@neziva/interfaces": "workspace:*",
    "@neziva/tools": "workspace:*",
    "@neziva/validations": "workspace:*",
    "@paralleldrive/cuid2": "2.2.2",
    "@prisma/client": "5.19.1",
    "bentocache": "1.4.0",
    "date-fns": "3.6.0",
    "orchid-orm": "^1.51.0",
    "znv": "0.4.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "chalk": "5.3.0",
    "prisma": "5.19.1"
  },
  "prisma": {
    "seed": "bun seed/index.ts"
  }
}
